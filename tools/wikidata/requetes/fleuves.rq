# Cours d'eau avec leur longueur (km), au moins 40 Wikipédias : matière à estimations.
SELECT ?e ?libelle ?longueur ?liens WHERE {
  ?e wdt:P31/wdt:P279* wd:Q4022; p:P2043/psv:P2043 [wikibase:quantityAmount ?longueur; wikibase:quantityUnit wd:Q828224].
  ?e wikibase:sitelinks ?liens. FILTER(?liens >= 40)
  ?e rdfs:label ?libelle. FILTER(LANG(?libelle)="fr")
} ORDER BY DESC(?liens) LIMIT 400
